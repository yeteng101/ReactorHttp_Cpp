# 复制为 .env；示例已填好你的域名（yeteng.xin），A 记录需解析到服务器公网 IP：
#   cp .env.example .env
# 如果使用其他域名，把下面的 DOMAIN 换成你自己的。
DOMAIN=yeteng.xin

# ---------- AI 助手（OpenAI 兼容接口） ----------
# 支持 OpenAI / DeepSeek / 通义千问 / Moonshot 等，把地址换成对应 /v1 即可
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# 建议在网页「AI 设置」里填，避免明文写进 .env；想用环境变量就填这里
AI_API_KEY=

# ---------- GitHub 登录（可选） ----------
# 在 GitHub -> Settings -> Developer settings -> OAuth Apps 新建应用：
#   Homepage URL: https://yeteng.xin
#   Authorization callback URL: https://yeteng.xin/api/oauth/github/callback
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# ---------- Apple 登录（可选，需 Apple Developer 会员） ----------
# Service ID、Team ID、Key ID 与 p8 私钥来自 developer.apple.com；
# 私钥建议放入 deploy/secrets/ 并在 docker-compose.yml 挂载
OAUTH_APPLE_SERVICE_ID=
OAUTH_APPLE_TEAM_ID=
OAUTH_APPLE_KEY_ID=
OAUTH_APPLE_PRIVATE_KEY_PATH=

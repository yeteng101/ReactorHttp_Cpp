# 复制为 .env 并改成你的域名：
#   cp .env.example .env
# 然后把 DOMAIN 改成真实域名，并确保该域名的 A 记录已解析到服务器公网 IP。
DOMAIN=your-domain.com

# ---------- AI 助手（OpenAI 兼容接口） ----------
# 支持 OpenAI / DeepSeek / 通义千问 / Moonshot 等，把地址换成对应 /v1 即可
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# 建议在网页「AI 设置」里填，避免明文写进 .env；想用环境变量就填这里
AI_API_KEY=

# ---------- GitHub 登录（可选） ----------
# 在 GitHub -> Settings -> Developer settings -> OAuth Apps 新建应用：
#   Homepage URL: https://你的域名
#   Authorization callback URL: https://你的域名/api/oauth/github/callback
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# ---------- Apple 登录（可选，需 Apple Developer 会员） ----------
# Service ID、Team ID、Key ID 与 p8 私钥来自 developer.apple.com；
# 私钥建议放入 deploy/secrets/ 并在 docker-compose.yml 挂载
OAUTH_APPLE_SERVICE_ID=
OAUTH_APPLE_TEAM_ID=
OAUTH_APPLE_KEY_ID=
OAUTH_APPLE_PRIVATE_KEY_PATH=
